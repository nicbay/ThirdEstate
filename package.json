{
  "name": "third-estate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-candidates.mjs && node scripts/build-programmes-index.mjs && tsc && vite build",
    "check:candidates": "node scripts/check-candidates.mjs",
    "preview": "vite preview",
    "sync:an": "node scripts/sync-assemblee.mjs",
    "sync:interventions": "node scripts/sync-interventions.mjs",
    "build:quiz": "node scripts/build-quiz.mjs",
    "sync:geo": "node scripts/sync-geo.mjs",
    "sync": "npm run sync:geo && npm run sync:results && npm run sync:an && npm run sync:polls && npm run sync:markets",
    "sync:polls": "node scripts/sync-polls.mjs",
    "sync:pollster-ratings": "node scripts/sync-pollster-ratings.mjs",
    "sync:markets": "node scripts/sync-markets.mjs",
    "sync:results": "node scripts/sync-results.mjs",
    "sync:economy": "node scripts/sync-economy.mjs",
    "sync:forecast": "esbuild scripts/forecast-history.ts --bundle --platform=node --format=esm --outfile=.cache/forecast-history.mjs --log-level=warning && node .cache/forecast-history.mjs",
    "sync:parrainages": "node scripts/sync-parrainages.mjs",
    "sync:daily": "esbuild scripts/daily-brief.ts --bundle --platform=node --format=esm --packages=external --outfile=.cache/daily-brief.mjs --log-level=warning && node .cache/daily-brief.mjs"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.0",
    "esbuild": "0.25.12",
    "node-html-parser": "^6.1.13",
    "typescript": "5.6.3",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@supabase/supabase-js": "^2.118.0",
    "d3-geo": "3.1.1",
    "fflate": "^0.8.3"
  }
}
